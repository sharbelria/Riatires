# Copy this file to .env.local and fill in the values.
# Never commit .env.local – it contains secrets.

# Public address of the site (used for sitemap, Open Graph and payment return URLs)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.il

# ---------- Supabase (database for orders and callback requests) ----------
# Supabase dashboard → your project → Connect (or Project Settings → API Keys).
# Use the PUBLISHABLE key (sb_publishable_...). Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret used to sign order links and payment callbacks. Any long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_SECRET=

# ---------- Email: option A – Gmail (recommended to start) ----------
# 1. Turn on 2-Step Verification in your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords  (16 letters)
# 3. Put your Gmail address and the App Password here (NOT your normal Gmail password).
SMTP_USER=Sharbelria4@gmail.com
SMTP_PASS=
# Defaults are for Gmail – change only for another mail provider
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------- Email: option B – Resend (https://resend.com) ----------
# Used only when SMTP_USER/SMTP_PASS are empty.
# RESEND_API_KEY=
# EMAIL_FROM=Riatires <orders@your-domain.co.il>

# Where new orders and callback requests are sent (defaults to the email in lib/site-config.ts)
ORDER_EMAIL_TO=Sharbelria4@gmail.com

# ---------- Credit card payments ----------
# "cardcom" = real payments through Cardcom's hosted payment page
# "mock"    = fake test gateway, for local testing only (never use in production)
PAYMENT_PROVIDER=cardcom
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# Optional – only change if Cardcom tells you to
# CARDCOM_API_BASE=https://secure.cardcom.solutions/api/v11
