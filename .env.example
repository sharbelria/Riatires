# Copy this file to .env.local and fill in the values.
# Never commit .env.local – it contains secrets.

# Public address of the site (used for sitemap, Open Graph and payment return URLs)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.il

# Secret used to sign order links and payment callbacks. Any long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_SECRET=

# ---------- Email (Resend – https://resend.com) ----------
RESEND_API_KEY=
# Sender address. Must be on a domain you verified in Resend, e.g. "Riatires <orders@your-domain.co.il>".
# For quick tests you can use: Riatires <onboarding@resend.dev>  (only delivers to your own Resend account email)
EMAIL_FROM=Riatires <onboarding@resend.dev>
# Where new orders and callback requests are sent (defaults to the email in lib/site-config.ts)
ORDER_EMAIL_TO=Sharbelria4@gmail.com

# ---------- Credit card payments ----------
# "cardcom" = real payments through Cardcom's hosted payment page
# "mock"    = fake test gateway, for local testing only (never use in production)
PAYMENT_PROVIDER=cardcom
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# Optional – only change if Cardcom tells you to
# CARDCOM_API_BASE=https://secure.cardcom.solutions/api/v11
